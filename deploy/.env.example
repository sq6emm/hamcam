# hamcam settings: copy to /etc/docker-compose/hamcam/.env (chmod 600) and fill in. Never commit the real file.

# images: ghcr.io/sq6emm/hamcam-{telemetry,web}:<HAMCAM_VERSION>  (latest, or a release version without "v", e.g. 0.0.9 or 0.0)
HAMCAM_VERSION=latest
# persistent data of the telemetry service, and the uid:gid it runs as (must be able to write HAMCAM_DATA)
HAMCAM_DATA=./data
HAMCAM_UID=1000
HAMCAM_GID=1000
# host port of the page
HAMCAM_WEB_PORT=8097
# only for compose.build.yaml: repository checkout to build from
# HAMCAM_SRC=/path/to/hamcam

# camera RTSP streams (with credentials)
CAMERA_MAIN_URL=rtsp://user:password@192.168.1.10:554/h264Preview_01_main
CAMERA_SUB_URL=rtsp://user:password@192.168.1.10:554/h264Preview_01_sub

# WebRTC media address(es) viewers connect to (UDP+TCP port 8556; forward both on the firewall for remote viewers)
WEBRTC_CANDIDATE_LAN=192.168.1.20:8556
# public address: "stun:8556" = discover the public IP via STUN and announce it with port 8556 (also works with a
# dynamic IP); an explicit IP:8556 works too. An IP is the safest choice for browsers.
WEBRTC_CANDIDATE_WAN=stun:8556

# Hamlib rotctld (empty host = simulated azimuth sweep)
ROTCTLD_HOST=192.168.1.30
ROTCTLD_PORT=4533

# weather JSON endpoint (API keys stay server-side) and the fields shown: name=dotted.path,...
WEATHER_URL=
WEATHER_FIELDS=

# ADS-B receiver aircraft.json (readsb / tar1090 / ultrafeeder)
ADSB_URL=http://192.168.1.20:8083/data/aircraft.json

# rotator control from the page (click-to-point, tracking aircraft/satellites):
#   CONTROL_ALLOW = client networks allowed to steer (comma-separated CIDRs); EMPTY = control disabled for everyone
#   TRUSTED_PROXY = address of your public front proxy: only its X-Forwarded-For is believed, so internet visitors
#                   coming through it are judged by their real address (otherwise they would all look like the proxy)
CONTROL_ALLOW=
TRUSTED_PROXY=127.0.0.1
# TRACK_STEP_DEG=2           move when the tracked target is this far off
# TRACK_MIN_INTERVAL_S=3     ... but at most this often
# TRACK_LEASE_S=10           tracking ends when the page stops confirming it (closed / disconnected)
# ROT_EL_MIN=0  ROT_EL_MAX=90   elevation range sent to rotctld (az-only rotators ignore the elevation)

# optional (defaults shown)
# BEACON_BAND=23cm
# BEACON_MAX_KM=900
# BEACON_KEEP_DAYS=90
# TLE_GROUPS=visual,amateur
# SOTA_ASSOCIATIONS=SP,OK
# SUMMIT_MAX_KM=250
