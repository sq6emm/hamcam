# hamcam settings: copy to /etc/docker-compose/hamcam/.env (chmod 600) and fill in. Never commit the real file.

# images: ghcr.io/sq6emm/hamcam-{telemetry,web}:<HAMCAM_VERSION>  (latest, or a release version without "v", e.g. 0.0.9 or 0.0)
HAMCAM_VERSION=latest
# persistent data of the telemetry service, and the uid:gid it runs as (must be able to write HAMCAM_DATA)
HAMCAM_DATA=./data
HAMCAM_UID=1000
HAMCAM_GID=1000
# host port of the page
HAMCAM_WEB_PORT=8097
# only for compose.build.yaml: repository checkout to build from
# HAMCAM_SRC=/path/to/hamcam

# camera RTSP streams (with credentials)
CAMERA_MAIN_URL=rtsp://user:password@192.168.1.10:554/h264Preview_01_main
CAMERA_SUB_URL=rtsp://user:password@192.168.1.10:554/h264Preview_01_sub

# WebRTC media address(es) viewers connect to (UDP+TCP port 8556; forward it on the firewall for remote viewers)
WEBRTC_CANDIDATE_LAN=192.168.1.20:8556
WEBRTC_CANDIDATE_WAN=example.org:8556

# Hamlib rotctld (empty host = simulated azimuth sweep)
ROTCTLD_HOST=192.168.1.30
ROTCTLD_PORT=4533

# weather JSON endpoint (API keys stay server-side) and the fields shown: name=dotted.path,...
WEATHER_URL=
WEATHER_FIELDS=

# ADS-B receiver aircraft.json (readsb / tar1090 / ultrafeeder)
ADSB_URL=http://192.168.1.20:8083/data/aircraft.json

# optional (defaults shown)
# BEACON_BAND=23cm
# BEACON_MAX_KM=900
# BEACON_KEEP_DAYS=90
# TLE_GROUPS=visual,amateur
# SOTA_ASSOCIATIONS=SP,OK
# SUMMIT_MAX_KM=250
