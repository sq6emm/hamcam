# Single entry point for the hamcam page. Exposed on host port 8097.
# Public: https://sq6emm.hamradio.pl/camera/ -> (front nginx strips /camera/) -> here.
# All page URLs are relative, so it works both under /camera/ and at the root.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

server {
    listen 8080;
    server_tokens off;

    root /usr/share/nginx/html;
    index index.html;

    # go2rtc signalling (WebRTC offer/answer over WebSocket) + MSE fallback stream
    location /api/ws {
        proxy_pass http://go2rtc:1985;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
        proxy_buffering off;
    }

    # go2rtc player web components
    location ~ ^/(video-rtc|video-stream)\.js$ {
        proxy_pass http://go2rtc:1985;
    }

    # still frame from the camera stream (used later for calibration)
    location /api/frame.jpeg {
        proxy_pass http://go2rtc:1985;
    }

    # rotator / weather telemetry
    location /telemetry {
        proxy_pass http://telemetry:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 1h;
    }

    # ADS-B aircraft.json from the receiver (ADSB_URL in .env; the template is filled in when nginx starts)
    location = /adsb/aircraft.json {
        proxy_pass ${ADSB_URL};
        add_header Cache-Control "no-cache";
    }

    # station / camera model / POIs: from the config directory (/etc/docker-compose/hamcam/config)
    location = /objects.json {
        alias /config/objects.json;
        add_header Cache-Control "no-cache";
    }

    location / {
        try_files $uri $uri/ =404;
        add_header Cache-Control "no-cache";
    }
}
